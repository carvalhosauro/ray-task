import { Theme } from "theme.slint";

export component Icon inherits Image {
    in property <length> size: 18px;
    width: root.size;
    height: root.size;
    image-fit: contain;
}

export component CheckCircle inherits Rectangle {
    in property <bool> done;
    in property <string> label;
    callback clicked;
    width: 32px;
    height: 32px;
    accessible-role: checkbox;
    accessible-checked: root.done;
    accessible-label: root.label;
    TouchArea {
        clicked => { root.clicked(); }
    }
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        border-width: 1.5px;
        border-color: root.done ? Theme.accent : Theme.ring;
        background: root.done ? Theme.accent : transparent;
        animate background, border-color { duration: 150ms; easing: ease-out; }
        Icon {
            size: 12px;
            source: @image-url("icons/check.svg");
            colorize: white;
            opacity: root.done ? 1 : 0;
            animate opacity { duration: 150ms; easing: ease-out; }
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    border-radius: 6px;
    background: Theme.chip;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text { text: root.text; color: Theme.sub; font-size: 12px; vertical-alignment: center; }
    }
}

export component Pill inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> text;
    in property <color> fg: Theme.text;
    in property <bool> dashed: false;
    callback clicked;
    height: 28px;
    border-radius: 8px;
    border-width: root.dashed ? 1px : 0px;
    border-color: Theme.ring;
    background: root.dashed ? transparent : touch.has-hover ? Theme.selection.with-alpha(0.6) : Theme.chip;
    accessible-role: button;
    accessible-label: root.text;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        if root.has-icon : Rectangle {
            width: 14px;
            Icon { size: 14px; source: root.icon; colorize: root.fg; }
        }
        Text { text: root.text; color: root.fg; font-size: 13px; vertical-alignment: center; }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.sub;
    in property <string> label;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    accessible-role: button;
    accessible-label: root.label;
    background: touch.has-hover ? Theme.selection.with-alpha(0.55) : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Icon { size: 18px; source: root.icon; colorize: root.tint; }
}

/// Fundo de popover/menu (usado dentro de PopupWindow).
export component MenuPanel inherits Rectangle {
    background: Theme.pop;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000030;
}

export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> has-dot;
    in property <color> dot;
    callback clicked;
    height: 30px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.chip : transparent;
    accessible-role: button;
    accessible-label: root.text;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.has-dot : Rectangle {
            width: 8px;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.dot; }
        }
        Text { text: root.text; font-size: 13.5px; color: root.danger ? Theme.red : Theme.text; vertical-alignment: center; }
    }
}

export component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked;
    height: 32px;
    min-width: 84px;
    border-radius: 8px;
    background: root.danger ? Theme.red : root.primary ? Theme.accent : Theme.chip;
    accessible-role: button;
    accessible-label: root.text;
    TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13.5px;
            font-weight: 600;
            color: (root.primary || root.danger) ? white : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// Fundo escurecido + cartão central. O conteúdo entra em @children.
export component Dialog inherits Rectangle {
    background: #00000040;
    TouchArea { }
    Rectangle {
        width: 340px;
        height: content.preferred-height;
        background: Theme.pop;
        border-radius: 14px;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #0000002e;
        content := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            @children
        }
    }
}
