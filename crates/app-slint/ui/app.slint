import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import { Theme } from "theme.slint";
import { NavItem, TaskItem } from "types.slint";
import { Actions, Picker } from "globals.slint";
import { Icon, IconButton, Dialog, DialogButton, MenuPanel } from "components.slint";
import { Sidebar } from "sidebar.slint";
import { TaskRow } from "task_row.slint";
export { Actions, Picker } from "globals.slint";
export { TagChip, NavItem, TaskItem, CalCell, ProjectChoice } from "types.slint";

component NewTaskRow inherits Rectangle {
    height: 44px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Rectangle {
            width: 32px;
            Rectangle { width: 22px; height: 22px; border-radius: 11px; border-width: 1.5px; border-color: Theme.ring; }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                font-size: 15px;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accessible-label: "Nova tarefa";
                init => { self.focus(); }
                accepted => {
                    Actions.commit-new(self.text);
                    self.text = "";
                }
            }
            if input.text == "" : Text { x: 0px; text: "Nova tarefa"; font-size: 15px; color: Theme.faint; vertical-alignment: center; }
        }
    }
}

component NewTaskButton inherits Rectangle {
    height: 44px;
    border-radius: 10px;
    background: touch.has-hover ? Theme.selection.with-alpha(0.4) : transparent;
    accessible-role: button;
    accessible-label: "Nova tarefa";
    touch := TouchArea { clicked => { Actions.new-task(); } }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 6px;
        Rectangle {
            width: 32px;
            Icon { size: 18px; source: @image-url("icons/plus.svg"); colorize: Theme.accent; }
        }
        Text { text: "Nova tarefa"; font-size: 15px; color: Theme.sub; vertical-alignment: center; }
    }
}

/// Fim da lista: nova tarefa, "Mostrar concluídas" e texto de lista vazia.
component ListFooter inherits VerticalLayout {
    in property <bool> adding;
    in property <string> done-toggle-label;
    in property <string> empty-text;
    padding-bottom: 20px;
    if root.adding : NewTaskRow { }
    if !root.adding : NewTaskButton { }
    if root.done-toggle-label != "" : HorizontalLayout {
        padding-left: 12px;
        padding-top: 12px;
        Text {
            text: root.done-toggle-label;
            font-size: 13px;
            color: Theme.sub;
            TouchArea { clicked => { Actions.toggle-show-done(); } }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.empty-text != "" : Text {
        text: root.empty-text;
        font-size: 14px;
        color: Theme.sub;
        horizontal-alignment: center;
        height: 120px;
        vertical-alignment: center;
    }
}

/// Flickable virtualizado, sem barra de rolagem (igual ao Flickable de antes; mesmo formato
/// do ListView do std-widgets, sem a ScrollBar).
/// O compilador do Slint trata um `for` filho direto de um elemento chamado `ListView`
/// que tenha content-y/-height/-width e visible-height/-width como lista virtual:
/// só instancia as linhas que cabem na área visível.
component ListView {
    in-out property <length> content-y <=> flick.content-y;
    in-out property <length> content-height <=> flick.content-height;
    in-out property <length> content-width <=> flick.content-width;
    out property <length> visible-width <=> flick.width;
    out property <length> visible-height <=> flick.height;

    // Rolagem até uma linha (teclado). As alturas variam e só as linhas visíveis existem,
    // então é em dois passos: `reveal` estima a posição (altura média, a mesma que a lista
    // virtual usa) e faz a linha ser criada; depois a própria linha corrige pelo `y` real
    // a cada `fine-request` (ver `for` em AppWindow).
    out property <int> fine-request;
    property <int> fine-ticks;
    public function reveal(index: int, count: int) {
        if (index < 0 || count <= 0) { return; }
        let avg = root.content-height / count;
        let top = index * avg + root.content-y;
        if (top < 0px) {
            root.content-y = min(0px, root.content-y - top);
        } else if (top + avg > root.visible-height) {
            root.content-y -= top + avg - root.visible-height;
        }
        // ~240 ms de correções: cobre a animação de abrir (200 ms) no Ctrl+D / Ctrl+T.
        root.fine-ticks = 15;
    }
    public function fit(top: length, height: length) {
        if (top < 0px) {
            root.content-y = min(0px, root.content-y - top);
        } else if (top + height > root.visible-height) {
            root.content-y -= min(top, top + height - root.visible-height);
        }
    }
    Timer {
        interval: 16ms;
        running: root.fine-ticks > 0;
        triggered => {
            root.fine-request += 1;
            root.fine-ticks -= 1;
        }
    }
    flick := Flickable {
        // Rolagem do usuário (roda/arrasto) vence a correção automática em andamento.
        flicked => { root.fine-ticks = 0; }
        @children
    }
}

component FilterField inherits Rectangle {
    width: 200px;
    height: 30px;
    border-radius: 8px;
    background: Theme.field;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 14px;
            Icon { size: 14px; source: @image-url("icons/search.svg"); colorize: Theme.sub; }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                font-size: 13px;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accessible-label: "Filtrar";
                init => { self.focus(); }
                edited => { Actions.filter-changed(self.text); }
            }
            if input.text == "" : Text { x: 0px; text: "Filtrar"; font-size: 13px; color: Theme.faint; vertical-alignment: center; }
        }
    }
}

/// Lista de sugestões do campo de tag: abaixo do campo, ou acima se não couber na janela.
component TagList inherits MenuPanel {
    in property <length> window-height;
    property <length> row-height: 26px;
    property <length> field-height: 28px;
    x: Actions.tag-anchor-x;
    y: Actions.tag-anchor-y + 4px + self.height <= root.window-height ? Actions.tag-anchor-y + 4px : Actions.tag-anchor-y - root.field-height - 4px - self.height;
    width: 200px;
    height: Actions.tag-options.length * root.row-height + 10px;
    VerticalLayout {
        padding: 5px;
        for name[i] in Actions.tag-options : Rectangle {
            height: root.row-height;
            border-radius: 7px;
            background: i == Actions.tag-highlighted ? Theme.accent : touch.has-hover ? Theme.chip : transparent;
            accessible-role: list-item;
            accessible-label: "#" + name;
            touch := TouchArea {
                clicked => { Actions.tag-pick(Actions.tag-list-task, name); }
            }
            Text {
                x: 10px;
                width: parent.width - 20px;
                text: "#" + name;
                font-size: 13px;
                color: i == Actions.tag-highlighted ? #FFFFFF : Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ray-task";
    icon: @image-url("../assets/icon/ray-task-256.png");
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 640px;
    min-height: 420px;
    default-font-family: "Inter";
    background: Theme.bg;

    in property <string> fatal-error;
    in property <[NavItem]> nav;
    in property <int> selected-nav;
    in property <string> view-title;
    in property <string> view-subtitle;
    in property <[TaskItem]> tasks;
    in property <int> expanded-id: -1;
    in property <int> selected-id: -1;
    // Linha que o teclado quer ver (↑/↓, Ctrl+D, Ctrl+T); cada pedido incrementa reveal-request.
    in property <int> reveal-index: -1;
    in property <int> reveal-request;
    in property <bool> adding;
    in property <string> empty-text;
    in property <string> done-toggle-label;
    in property <bool> filter-visible;
    in property <bool> content-faded;
    in property <bool> toast-visible;
    in property <string> toast-text;
    in property <string> toast-action;
    in-out property <int> toast-kind;
    in property <bool> prompt-visible;
    in property <string> prompt-title;
    in property <string> prompt-text;
    in property <string> prompt-error;
    in property <bool> confirm-visible;
    in property <string> confirm-title;
    in property <string> confirm-message;
    in property <string> confirm-button;

    public function focus-root() { keys.focus(); }

    keys := FocusScope {
        key-pressed(event) => {
            // Atalhos globais: keymap em Rust (crates/app-slint/src/keys.rs), também a fonte da tabela do README.
            return Actions.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject;
        }

        if root.fatal-error != "" : Rectangle {
            background: Theme.bg;
            VerticalLayout {
                alignment: center;
                padding: 48px;
                spacing: 12px;
                Text { text: "Não foi possível iniciar"; font-size: 20px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                Text { text: root.fatal-error; font-size: 14px; color: Theme.sub; wrap: word-wrap; horizontal-alignment: center; }
            }
        }

        if root.fatal-error == "" : HorizontalLayout {
            Sidebar { nav: root.nav; selected: root.selected-nav; }
            main := Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    opacity: root.content-faded ? 0 : 1;
                    animate opacity { duration: 60ms; easing: ease-out; }
                    VerticalLayout {
                        HorizontalLayout {
                            padding-left: 32px;
                            padding-right: 24px;
                            padding-top: 28px;
                            padding-bottom: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: root.view-title; font-size: 26px; font-weight: 700; letter-spacing: -0.5px; color: Theme.text; }
                                Text { text: root.view-subtitle; font-size: 13px; color: Theme.sub; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if root.filter-visible : VerticalLayout {
                                alignment: center;
                                FilterField { }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("icons/plus.svg");
                                    tint: Theme.accent;
                                    label: "Nova tarefa";
                                    clicked => { Actions.new-task(); }
                                }
                            }
                        }
                        // Lista vazia: o rodapé fica fora da lista virtual (não há última linha para carregá-lo).
                        if root.tasks.length == 0 : ListFooter {
                            vertical-stretch: 0;
                            padding-left: 20px;
                            padding-right: 20px;
                            adding: root.adding;
                            done-toggle-label: root.done-toggle-label;
                            empty-text: root.empty-text;
                        }
                        task-list := ListView {
                            vertical-stretch: 1;
                            // Nova tarefa entra no fim: rola até lá para o campo existir e receber o foco.
                            property <bool> adding: root.adding;
                            changed adding => {
                                if (self.adding && self.content-height > self.visible-height) {
                                    self.content-y = -self.content-height;
                                }
                            }
                            property <int> reveal-request: root.reveal-request;
                            changed reveal-request => { self.reveal(root.reveal-index, root.tasks.length); }
                            // Só as linhas visíveis existem; o rodapé vai junto da última linha.
                            for item[i] in root.tasks : VerticalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                // Linha alvo do teclado: garante que está inteira na tela (y real).
                                property <int> fine: task-list.fine-request;
                                changed fine => {
                                    if (i == root.reveal-index) {
                                        task-list.fit(self.y + task-list.content-y, self.height);
                                    }
                                }
                                TaskRow {
                                    item: item;
                                    expanded: item.id == root.expanded-id;
                                    selected: item.id == root.selected-id;
                                }
                                if i == root.tasks.length - 1 : ListFooter {
                                    adding: root.adding;
                                    done-toggle-label: root.done-toggle-label;
                                    empty-text: root.empty-text;
                                }
                            }
                        }
                    }
                }

                // Toast: "Tarefa concluída · Desfazer" / "Falha ao salvar · Tentar de novo"
                toast := Rectangle {
                    width: toast-layout.preferred-width;
                    height: 40px;
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 20px + (root.toast-visible ? 0px : 20px);
                    opacity: root.toast-visible ? 1 : 0;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate y { duration: 250ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.2); }
                    border-radius: 12px;
                    background: Theme.toast;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #00000040;
                    toast-layout := HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 6px;
                        spacing: 12px;
                        Text { text: root.toast-text; color: white; font-size: 13.5px; vertical-alignment: center; }
                        Rectangle {
                            width: action-text.preferred-width + 16px;
                            border-radius: 6px;
                            background: action-touch.has-hover ? #ffffff1a : transparent;
                            accessible-role: button;
                            accessible-label: root.toast-action;
                            action-touch := TouchArea {
                                enabled: root.toast-visible;
                                clicked => { Actions.toast-action(); }
                            }
                            action-text := Text { text: root.toast-action; color: #64B0FF; font-size: 13.5px; font-weight: 600; }
                        }
                    }
                }
            }
        }

        if root.prompt-visible : Dialog {
            Text { text: root.prompt-title; font-size: 15px; font-weight: 600; color: Theme.text; }
            Rectangle {
                height: 32px;
                border-radius: 8px;
                background: Theme.field;
                prompt-input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    text: root.prompt-text;
                    font-size: 14px;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    accessible-label: root.prompt-title;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => { Actions.prompt-accept(self.text); }
                }
            }
            if root.prompt-error != "" : Text { text: root.prompt-error; font-size: 12.5px; color: Theme.red; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton { text: "Cancelar"; clicked => { Actions.dialog-cancel(); } }
                DialogButton { text: "OK"; primary: true; clicked => { Actions.prompt-accept(prompt-input.text); } }
            }
        }

        if root.confirm-visible : Dialog {
            Text { text: root.confirm-title; font-size: 15px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: root.confirm-message; font-size: 13.5px; color: Theme.sub; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton { text: "Cancelar"; clicked => { Actions.dialog-cancel(); } }
                DialogButton { text: root.confirm-button; danger: true; clicked => { Actions.confirm-accept(); } }
            }
        }
    }

    // Sugestões do campo de tag, por cima de tudo (fora do FocusScope: o foco fica no campo).
    if Actions.tag-list-open && Actions.tag-options.length > 0 : TagList {
        window-height: root.height;
    }
}
