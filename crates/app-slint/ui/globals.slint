import { ProjectChoice, CalCell, TagKey } from "types.slint";

export global Actions {
    // navegação
    callback select-nav(int);
    callback open-settings();
    callback toggle-help();
    // tarefas
    callback toggle(int);
    callback expand(int);
    callback new-task();
    callback commit-new(string);
    callback edit(int, string, string);
    callback delete(int);
    callback undo();
    callback toast-action();
    // tags e mover
    callback add-tag(int, string);
    callback remove-tag(int, int);
    callback remove-last-tag(int);
    pure callback tag-suggest(int, string) -> string;
    callback request-move(int, int);
    in property <[ProjectChoice]> move-targets;
    in-out property <int> focus-tag-request: 0;
    in-out property <int> focus-tag-task: -1;
    // último focus-tag-request atendido (detalhes criados depois do pedido ainda o atendem)
    in-out property <int> focus-tag-handled: 0;
    // Enter/expand-selected pede foco no título da tarefa aberta (mesmo esquema do focus-tag-*)
    in-out property <int> focus-title-request: 0;
    in-out property <int> focus-title-task: -1;
    in-out property <int> focus-title-handled: 0;
    // lista de sugestões do campo de tag (desenhada por cima de tudo em app.slint)
    in-out property <bool> tag-list-open;
    in-out property <[string]> tag-options;
    in-out property <int> tag-highlighted: -1;
    in-out property <int> tag-list-task: -1;
    in-out property <length> tag-anchor-x;
    in-out property <length> tag-anchor-y;
    in-out property <int> tag-clear-request;
    // faixa visível da lista de tarefas: o campo rolado para fora esconde a lista
    in-out property <length> tag-clip-top;
    in-out property <length> tag-clip-bottom;
    callback tag-focus(int, bool, string);
    callback tag-input(int, string);
    // tecla: texto do campo, `event.text` e se havia Ctrl/Alt/Meta
    callback tag-key(int, string, string, bool) -> TagKey;
    callback tag-pick(int, string);
    // teclado e filtro
    // Atalho global: texto + modificadores do evento → `true` se havia ação para ele.
    callback key(string, bool, bool, bool, bool) -> bool;
    callback escape();
    callback move-selection(int);
    callback expand-selected();
    callback toggle-selected();
    callback delete-selected();
    callback date-selected();
    callback tag-selected();
    callback toggle-filter();
    callback filter-changed(string);
    callback toggle-show-done();
    // projetos, tags e diálogos
    callback new-project();
    callback begin-rename-project(int);
    callback set-project-color(int, int);
    callback request-delete-project(int);
    callback begin-rename-tag(int);
    callback request-delete-tag(int);
    callback prompt-accept(string);
    callback confirm-accept();
    callback dialog-cancel();
}

export global Picker {
    in property <string> month-title;
    in property <[CalCell]> cells;
    in property <string> time-text;
    in property <string> next-week-hint;
    in-out property <int> open-for: -1;
    in-out property <int> request: 0;
    in-out property <int> close-request: 0;
    // último request atendido (detalhes criados depois do pedido ainda o atendem)
    in-out property <int> handled-request: 0;
    callback open(int);
    callback shift-month(int);
    callback pick(int, string);
    callback quick(int, int);
    callback set-time(int, string);
}
